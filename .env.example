# ── Telegram Notifications (required for alerts) ──────────────────────────────
# Create a bot via @BotFather on Telegram, then run: python setup_telegram.py
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Minimum relevance score to trigger a Telegram alert (default: 10)
# Score guide: MCP=10pts, Claude=5pts, AI agent/LLM=3pts, automation=2pts
NOTIFY_MIN_SCORE=10

# ── Reddit (optional) ─────────────────────────────────────────────────────────
# Reddit now uses public JSON endpoints — NO credentials needed by default.
# Only fill these in if you want higher rate limits via the official API.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=mcp-lead-finder/1.0
